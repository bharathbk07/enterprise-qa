{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Engineering RCA record",
  "type": "object",
  "required": [
    "investigation_id",
    "application_id",
    "environment",
    "cause",
    "classification",
    "evidence_matrix",
    "cause_scores"
  ],
  "properties": {
    "investigation_id": {
      "type": "string",
      "minLength": 1
    },
    "application_id": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "string",
      "minLength": 1
    },
    "cause": {
      "type": "string",
      "minLength": 1
    },
    "classification": {
      "enum": [
        "suspected",
        "probable",
        "confirmed"
      ]
    },
    "evidence_matrix": {
      "type": "object",
      "properties": {
        "logs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "traces": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "metrics": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "code": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "mechanism_evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "missing_sources": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "contradictions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "cause_scores": {
      "type": "object",
      "required": [
        "test-data",
        "application-api-bug",
        "automation-code",
        "ui-locator-change",
        "environment"
      ],
      "properties": {
        "test-data": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "application-api-bug": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "automation-code": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "ui-locator-change": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "environment": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "classification": {
            "const": "confirmed"
          }
        },
        "required": [
          "classification"
        ]
      },
      "then": {
        "required": [
          "mechanism_evidence"
        ],
        "properties": {
          "mechanism_evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "evidence_matrix": {
            "required": [
              "logs",
              "traces",
              "metrics",
              "code"
            ],
            "properties": {
              "logs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "traces": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "metrics": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "code": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              }
            }
          },
          "missing_sources": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "maxItems": 0
          },
          "contradictions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "maxItems": 0
          }
        }
      }
    }
  ]
}
