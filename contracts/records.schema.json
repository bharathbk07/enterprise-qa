{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QA execution run",
  "type": "object",
  "required": [
    "schema_version",
    "application_id",
    "run_id",
    "environment",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "application_id": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "environment": {
      "type": "string"
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "case_id",
          "case_version",
          "flow_id",
          "flow_version",
          "execution_kind",
          "attempts"
        ],
        "properties": {
          "case_id": {
            "type": "string"
          },
          "case_version": {
            "type": "integer",
            "minimum": 1
          },
          "flow_id": {
            "type": "string"
          },
          "flow_version": {
            "type": "integer",
            "minimum": 1
          },
          "execution_kind": {
            "enum": [
              "manual-browser",
              "manual-api",
              "automated"
            ]
          },
          "attempts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "status",
                "started_at",
                "ended_at",
                "evidence"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "passed",
                    "failed",
                    "blocked",
                    "not-executed"
                  ]
                },
                "started_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "ended_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
